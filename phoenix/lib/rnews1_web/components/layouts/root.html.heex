<%
  # One of our own news sites that is not the archive carries its own name and
  # nothing of Rnews1's, apart from the credit in the footer: its readers came
  # for that title, not for the briefing product. The archive itself, and every
  # app and tenant page, keep reading content.json exactly as before.
  publication = assigns[:publication]
  own_masthead = publication != nil and publication.slug != Rnews1.Publications.default_slug()
  masthead_name = if own_masthead, do: publication.name, else: @brand.name
  masthead_line = if own_masthead, do: publication.tagline, else: @brand.tagline

  # A page that knows what it is about says so: a story by its standfirst, a
  # customer's site by its own industry and topics. Without that, every hosted
  # page would carry RNews1's description of itself to the search results.
  meta_description =
    case assigns[:meta_description] do
      text when is_binary(text) and text != "" -> text
      _ -> if own_masthead, do: publication.tagline || publication.name, else: @brand.description
    end
%>
<!doctype html>
<html lang={assigns[:html_lang] || "en"} dir={assigns[:dir] || "ltr"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <%= if assigns[:indexable] do %>
    <meta name="description" content={meta_description} />
  <% else %>
    <meta name="robots" content="noindex" />
  <% end %>
  <title><%= if own_masthead do %><%= assigns[:page_title] || masthead_name %><%= if assigns[:page_title] && assigns[:page_title] != masthead_name do %> — <%= masthead_name %><% end %><% else %><%= assigns[:page_title] || "RNews1" %> — <%= @brand.name %><% end %></title>
  <%= if assigns[:canonical_url] do %>
    <link rel="canonical" href={@canonical_url} />
  <% end %>
  <%= for alt <- assigns[:alternates] || [] do %>
    <link rel="alternate" hreflang={alt.language} href={alt.url} />
    <%= if alt.language == "en" do %>
      <link rel="alternate" hreflang="x-default" href={alt.url} />
    <% end %>
  <% end %>
  <link rel="stylesheet" href="/site.css" />
  <%= if assigns[:track] != false do %>
    <script src="/track.js" defer></script>
  <% end %>
  <%= if analytics = Rnews1Web.Analytics.for_page(assigns) do %>
    <script src={analytics.src} data-site={analytics.site} data-project={analytics.project} data-forms="false" defer></script>
  <% end %>
</head>
<%
  offsite = assigns[:offsite] == true
  site = assigns[:site]
  home = cond do
    assigns[:archive] -> "/"
    offsite -> @app_origin <> "/"
    true -> "/"
  end
  root = if offsite, do: @app_origin, else: ""
  chrome = assigns[:chrome] != false
  tenant = site && site[:tenant]
%>
<body class={assigns[:body_class] || ""}>
  <nav>
    <%= if tenant do %>
      <a class="brand" href={site.origin <> "/"}>
        <%= tenant.name || "News" %><span> / news</span>
      </a>
      <%= if chrome do %>
        <span class="nav-links"><a href={site.origin <> "/feed.xml"}>RSS</a></span>
      <% end %>
    <% else %>
      <a class="brand" href={home}>
        <%= masthead_name %><%= if masthead_line do %><span> / <%= masthead_line %></span><% end %>
      </a>
      <%= if chrome and not own_masthead do %>
        <span class="nav-links">
          <%= if assigns[:signed_in] do %>
            <a href={root <> "/app"}>Dashboard</a>
          <% else %>
            <a href={root <> "/login"}>Sign in</a>
          <% end %>
        </span>
      <% end %>
    <% end %>
  </nav>
  <main>
    <%= @inner_content %>
  </main>
  <footer>
    <%= if tenant && tenant.domain do %>
      <a href={"https://" <> tenant.domain} rel="noopener"><%= tenant.name %></a> ·
    <% end %>
    <%= if assigns[:branding] != false do %>
      <a href={root <> "/"}>Powered by RNews1</a> ·
    <% end %>
    <%= if chrome && !tenant && !own_masthead do %>
      <%= if assigns[:signed_in] do %>
        <a href={root <> "/app"}>Dashboard</a> ·
      <% else %>
        <a href={root <> "/login"}>Sign in or create an account</a> ·
      <% end %>
    <% end %>
    <a href={root <> "/privacy"}>Privacy</a> ·
    <a href={root <> "/terms"}>Terms</a>
  </footer>
</body>
</html>
