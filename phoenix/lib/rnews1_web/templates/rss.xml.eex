<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title><%= e(@tenant.name) %> news — RNews1</title>
    <link><%= e(@site_url) %></link>
    <atom:link href="<%= e(@feed_url) %>" rel="self" type="application/rss+xml" />
    <description>Daily <%= e(news_label(@tenant.industry)) %><%= if @tenant.name not in [nil, ""] do %> from <%= e(@tenant.name) %><% end %>, written by RNews1</description>
    <language><%= e(@tenant.language) %></language>
    <lastBuildDate><%= e(@last_build_date) %></lastBuildDate>
<%= for item <- @items do %>
    <item>
      <title><%= e(item.title) %></title>
      <link><%= e(item.hosted_url) %></link>
      <guid isPermaLink="true"><%= e(item.hosted_url) %></guid>
      <description><%= e(item.summary) %> Source: <%= e(item.source) %>. Powered by RNews1.</description>
      <pubDate><%= e(item.pub_date) %></pubDate>
    </item>
<% end %>
  </channel>
</rss>
