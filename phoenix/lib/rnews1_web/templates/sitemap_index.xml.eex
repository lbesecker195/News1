<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<%= for map <- @sitemaps do %>
  <sitemap>
    <loc><%= e(map.loc) %></loc>
<%= if map[:lastmod] do %>
    <lastmod><%= e(map.lastmod) %></lastmod>
<% end %>
  </sitemap>
<% end %>
</sitemapindex>
