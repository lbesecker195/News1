<%!--
  The console. Everything here used to be one 4,000px column of six numbered
  cards, so finding anything meant scrolling and the onboarding numbering never
  stopped being onboarding. It is now a shell: a site switcher, a sidebar, and
  one visible pane at a time, with an overview that answers the only question a
  returning customer actually has — is my briefing live, and if not, what is
  stopping it.

  Every element id below is a contract with app.js. Panes moved; ids did not.
--%>

<div class="console">
  <a class="skip" href="#console-main">Skip to content</a>

  <header class="console-bar">
    <div class="console-site">
      <label class="visually-hidden" for="site-switcher">Current site</label>
      <select id="site-switcher" aria-describedby="site-switcher-note">
        <option value="">Loading…</option>
      </select>
      <p id="site-switcher-note" class="small muted">Switch between the sites on this account.</p>
    </div>

    <p id="message" role="status" aria-live="polite"></p>
  </header>

  <div class="console-body">
    <nav class="console-nav" aria-label="Sections">
      <a href="#overview" data-pane-link="overview" aria-current="page">
        Overview <span class="pill" id="nav-blockers" hidden></span>
      </a>
      <a href="#content" data-pane-link="content">Content</a>
      <a href="#audience" data-pane-link="audience">Audience</a>
      <a href="#site" data-pane-link="site">Site</a>
      <a href="#billing" data-pane-link="billing">Billing</a>
      <a href="#account" data-pane-link="account">Account</a>
    </nav>

    <div class="console-main" id="console-main">
      <%!-- ---- Overview ------------------------------------------------- --%>
      <section class="pane" data-pane="overview">
        <div class="pane-head">
          <h1>Overview</h1>
          <p class="small muted" id="overview-sub">Where your newsletter stands today.</p>
        </div>

        <div class="status-card" id="status-card">
          <p class="status-line"><span class="dot" id="status-dot"></span><strong id="status-headline">Checking…</strong></p>
          <p class="small muted" id="status-detail"></p>
        </div>

        <div id="site-detail" hidden></div>

        <h2 class="section-label">Before your site can publish</h2>
        <ol class="checklist" id="checklist"></ol>

        <div class="grid-2">
          <div class="card">
            <h2>Your address</h2>
            <p id="site-address" class="site-address"></p>
            <p id="feed-links" data-briefing-only></p>
            <p id="publish-state" class="small" data-briefing-only></p>
          </div>

          <%!--
            The preview, the feed links and the publish gate are briefing
            concepts. A news site publishes articles at its own URLs and has no
            roster to gate on, so these are hidden rather than shown answering
            a question nobody asked.
          --%>
          <div class="card" data-briefing-only>
            <h2>Latest coverage</h2>
            <div id="preview">Save your topics to prepare a preview.</div>
            <button type="button" id="refresh-preview">Refresh preview</button>
          </div>
        </div>
      </section>

      <%!-- ---- Content -------------------------------------------------- --%>
      <section class="pane" data-pane="content" hidden>
        <div class="pane-head">
          <h1>Content</h1>
          <p class="small muted">One industry and two keywords. Up to three stories a day are written from them, for your newsletter and your site.</p>
        </div>

        <div class="card">
          <form id="company-form">
            <div class="field-grid">
              <label>Company name <input name="name" required maxlength="100" /></label>
              <label>Company domain <input name="domain" required placeholder="example.com" /></label>
              <label>Industry <input name="industry" required maxlength="100" placeholder="Industrial robotics" /></label>
              <label>Newsletter language
                <select name="language">
                  <option value="en">English</option>
                  <option value="es">Spanish</option>
                  <option value="fr">French</option>
                  <option value="de">German</option>
                </select>
              </label>
              <label>Keyword 1 <input name="keyword1" required maxlength="60" placeholder="warehouse automation" /></label>
              <label>Keyword 2 <input name="keyword2" required maxlength="60" placeholder="grippers" /></label>
            </div>

            <div class="actions">
              <button>Save and prepare preview</button>
              <button type="button" class="secondary" id="suggest">Suggest topics</button>
            </div>
          </form>
        </div>
      </section>

      <%!-- ---- Audience ------------------------------------------------- --%>
      <section class="pane" data-pane="audience" hidden>
        <div class="pane-head">
          <h1>Audience</h1>
          <p class="small muted">
            Everyone you add gets the daily newsletter from the next send. Your own address
            counts as the first; once 10 are on your list, your site, RSS feed and embed go
            live, and they stay live while 10 or more remain.
          </p>
        </div>

        <div class="card">
          <p id="stakeholder-state" class="small"></p>

          <form id="invite-form">
            <label>Recipient email <input name="email" type="email" required /></label>
            <label class="check">
              <input name="authorised" type="checkbox" required />
              I have the authority to add this person to this list and to send them this newsletter.
            </label>
            <div class="actions"><button>Add recipient</button></div>
          </form>

          <p class="small muted">
            Every issue carries a one-click unsubscribe, and an address that opts out or bounces is
            suppressed across the whole platform and cannot be re-added.
          </p>

          <ul id="subscribers"></ul>
        </div>
      </section>

      <%!-- ---- Site ----------------------------------------------------- --%>
      <section class="pane" data-pane="site" hidden>
        <div class="pane-head">
          <h1>Site</h1>
          <p class="small muted">
            Your site, RSS feed and embed live at this address. Once it is published, every story
            gets its own indexable page here, and the latest are listed in its sitemap.
          </p>
        </div>

        <div class="card">
          <h2>Address</h2>
          <form id="subdomain-form">
            <label>Subdomain
              <span class="affix">
                <input name="subdomain" required minlength="3" maxlength="63"
                       pattern="[a-z0-9]([a-z0-9-]*[a-z0-9])?"
                       autocomplete="off" spellcheck="false" />
                <span class="suffix" id="sites-domain"></span>
              </span>
            </label>
            <p class="small muted" id="rename-note"></p>
            <div class="actions"><button class="secondary">Rename</button></div>
          </form>
        </div>

        <div class="card">
          <h2>Custom domain <span id="plan-badge" class="badge" hidden></span></h2>
          <p class="small muted" id="domain-intro">
            Point a hostname you control at your site. Add it here, then create the DNS record
            shown. It goes live the moment the record is visible.
          </p>

          <form id="domain-form">
            <label>Hostname
              <input name="hostname" placeholder="news.yourcompany.com" required
                     maxlength="253" autocomplete="off" spellcheck="false" />
            </label>
            <div class="actions"><button class="secondary">Use this domain</button></div>
          </form>

          <div id="domain-status" hidden>
            <p id="domain-state" class="small"></p>
            <table class="dns">
              <thead><tr><th>Type</th><th>Name</th><th>Value</th></tr></thead>
              <tbody id="dns-rows"></tbody>
            </table>
            <div class="actions">
              <button type="button" class="secondary" id="verify-domain">Check DNS now</button>
              <button type="button" class="danger" id="remove-domain">Remove domain</button>
            </div>
          </div>
        </div>

        <div class="card">
          <h2>Feed and embed</h2>
          <label>Iframe embed <textarea id="embed-code" readonly rows="3"></textarea></label>
          <div class="actions"><button type="button" class="secondary" id="copy-digest">Copy branded digest</button></div>
        </div>
      </section>

      <%!-- ---- Billing -------------------------------------------------- --%>
      <section class="pane" data-pane="billing" hidden>
        <div class="pane-head">
          <h1>Billing</h1>
          <p class="small muted">No card is needed to preview your coverage.</p>
        </div>

        <div class="card">
          <p id="billing-status"></p>
          <p id="comped-note" class="small ok" hidden></p>
          <div class="actions">
            <button id="checkout" hidden>Activate for $25/month with PayPal →</button>
            <button id="cancel" class="secondary" hidden>Cancel renewal</button>
          </div>
        </div>
      </section>

      <%!-- ---- Account -------------------------------------------------- --%>
      <section class="pane" data-pane="account" hidden>
        <div class="pane-head">
          <h1>Account</h1>
          <p class="small muted">You can always sign in by emailed link instead of a password.</p>
        </div>

        <div class="card" id="password-card">
          <h2>Password</h2>
          <p class="small" id="password-state"></p>

          <form id="password-form">
            <label id="current-label" hidden>
              Current password
              <input name="current" type="password" autocomplete="current-password" />
            </label>
            <label>
              <span id="password-label">New password</span>
              <input name="password" type="password" minlength="8" autocomplete="new-password" required />
            </label>
            <p class="small muted">
              At least 8 characters. Setting or changing it signs out every other session.
            </p>
            <div class="actions">
              <button>Save password</button>
              <button type="button" class="secondary" id="remove-password" hidden>Remove password</button>
            </div>
          </form>
        </div>

        <div class="card">
          <h2>Session</h2>
          <div class="actions"><button type="button" class="secondary" id="logout">Sign out</button></div>
        </div>
      </section>
    </div>
  </div>
</div>

<script src="/app.js" defer></script>
