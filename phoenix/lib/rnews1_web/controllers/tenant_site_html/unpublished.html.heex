<section class="card">
  <h1><%= @tenant.name || "This site" %> is coming soon</h1>
  <p>
    This news site is not published right now. It goes live once its subscription is active and <%= @required %> addresses are on its newsletter list.
    If it is yours, finish setting it up at
    <a href={@app_origin <> "/app"}><%= String.replace(@app_origin, ~r/^https?:\/\//, "") %>/app</a>.
  </p>
</section>
