# ---- Web + worker ----------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/rnews1
APP_ORIGIN=http://localhost:3000
# Physical postal address of the sender. Required in every commercial
# message by CAN-SPAM; the worker will not start without it.
BUSINESS_ADDRESS=1 Example St, Springfield, CA 90000
SUPPORT_EMAIL=support@example.com
PORT=3000

# Set to 1 when running behind a reverse proxy (Fly, Render, nginx, ...).
# Required for correct client IPs in the rate limiter.
TRUST_PROXY=0

# Where generated PDF briefs are written. Relative paths resolve from the
# project root, not the current working directory.
DATA_DIR=./data

# ---- PayPal (web) ----------------------------------------------------------
# The same PayPal application as csuite_finder: these variable names match that
# project's, so one set of credentials serves both. sandbox or live.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you register at https://<host>/webhooks/paypal for the
# BILLING.SUBSCRIPTION.* and PAYMENT.SALE.COMPLETED events.
PAYPAL_WEBHOOK_ID=
# Overrides the mode-derived API host if you need to.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- Mailgun (worker sends, web verifies webhooks) -------------------------
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=Rnews1 <briefings@mg.example.com>
MAILGUN_WEBHOOK_SIGNING_KEY=...
# Use https://api.eu.mailgun.net for EU-region domains.
MAILGUN_API_BASE=https://api.mailgun.net

# Extra hosts that serve our own published stories — custom domains on the
# enterprise plan. Comma separated, host only. APP_ORIGIN is always included.
# Anything matching these is never re-read and rewritten as if it were news.
# OWN_HOSTS=news.customer.com,briefing.othercustomer.com

# ---- Story discovery (treg) ------------------------------------------------
# Mint the worker its own identity: treg org agent-new rnews1-worker
TREG_TOKEN=
# exa   neural search, ~$0.007/call — genuine recent news, real publish dates
# serp  Google News via DataForSEO, ~$0.002/call — cheaper, noisier
NEWS_PROVIDER=exa

# ---- OpenAI (worker summaries, web topic suggestions) ----------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# ---- Digest scheduling -----------------------------------------------------
# Hour of day (UTC, 0-23) the daily digest is queued.
DIGEST_HOUR=13
