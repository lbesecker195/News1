# ---- Web + worker ----------------------------------------------------------
DATABASE_URL=postgres://logan@localhost:5432/rnews1
APP_ORIGIN=http://localhost:3000
SUPPORT_EMAIL=support@example.com
PORT=3000

# Set to 1 when running behind a reverse proxy (Fly, Render, nginx, ...).
# Required for correct client IPs in the rate limiter.
TRUST_PROXY=1

# Where generated PDF briefs are written. Relative paths resolve from the
# project root, not the current working directory.
DATA_DIR=./data

# ---- Stripe (web) ----------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Mailgun (worker sends, web verifies webhooks) -------------------------
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=Rnews1 <briefings@mg.example.com>
MAILGUN_WEBHOOK_SIGNING_KEY=...
# Use https://api.eu.mailgun.net for EU-region domains.
MAILGUN_API_BASE=https://api.mailgun.net

# ---- OpenAI (worker summaries, web topic suggestions) ----------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# ---- Digest scheduling -----------------------------------------------------
# Hour of day (UTC, 0-23) the daily digest is queued.
DIGEST_HOUR=13
