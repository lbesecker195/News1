<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title><%= title %></title>
<style>
  /*
   * One sheet, three ways: read on screen, printed, and rendered to PDF by a
   * headless browser. Everything is inline — no fonts, styles or scripts are
   * fetched — so the PDF renderer needs no network at all.
   *
   * The page is a landing page, not a memo: one story leads as a hero card,
   * the rest are headlines that open. Every card is a link.
   */
  :root {
    --accent: <%= content.theme.accent %>;
    --ink: <%= content.theme.ink %>;
    --muted: <%= content.theme.muted %>;
    --paper: <%= content.theme.paper %>;
    --ground: #eceef2;
    --rule: #dde1e7;
    --rule-soft: #eceef2;
    /* The accent, lifted to read on the ink of the hero card. */
    --accent-on-ink: var(--accent);
    --accent-on-ink: color-mix(in srgb, var(--accent) 55%, #ffffff);
    --paper-on-ink: color-mix(in srgb, var(--paper) 78%, transparent);
    --paper-dim: color-mix(in srgb, var(--paper) 58%, transparent);
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Charter,
             Georgia, "Times New Roman", serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
            Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }

  a { color: inherit; text-decoration: none; }

  .sheet {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.6rem 2.75rem 2rem;
    background: var(--paper);
    min-height: 100vh;
    border-top: 5px solid var(--accent);
  }

  /* ---- labels ----------------------------------------------------------- */

  .label {
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---- masthead --------------------------------------------------------- */

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--ink);
    font-family: var(--sans);
    font-size: 0.78rem;
  }

  .topbar .brand { font-weight: 700; letter-spacing: -0.01em; }
  .topbar .brand span { font-weight: 400; color: var(--muted); }
  .topbar .when { color: var(--muted); }

  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding: 0.9rem 0 1rem;
  }

  .masthead h1 {
    margin: 0.25rem 0 0;
    font-size: 1.55rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .masthead .eyebrow { margin: 0; }

  .prepared {
    text-align: end;
    font-family: var(--sans);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--muted);
    max-width: 18rem;
  }

  .prepared strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- summary strip ---------------------------------------------------- */

  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    margin: 0;
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 0.8rem;
  }

  .summary div { display: flex; gap: 0.5rem; align-items: baseline; min-width: 0; }
  .summary dt { font-size: 0.62rem; }
  .summary dd { margin: 0; font-weight: 600; }

  /* ---- hero ------------------------------------------------------------- */

  .hero {
    display: block;
    margin: 0.2rem 0 1.1rem;
    padding: 1.5rem 1.75rem 1.35rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 3px;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .hero .kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    align-items: baseline;
    margin: 0 0 0.85rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--paper-on-ink);
  }

  .hero .kicker .section {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-on-ink);
  }

  .hero h2 {
    margin: 0;
    font-size: 2.15rem;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero .standfirst {
    margin: 0.8rem 0 0;
    max-width: 38rem;
    font-size: 1.06rem;
    line-height: 1.5;
    color: var(--paper-on-ink);
  }

  .hero .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.15rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--paper-dim);
    font-family: var(--sans);
    font-size: 0.74rem;
    color: var(--paper-dim);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    background: var(--accent);
    color: #ffffff;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .cta .arrow { transition: transform 160ms ease; }

  /* ---- the rest of the day ---------------------------------------------- */

  .more { margin: 0; }

  .more .label { display: block; padding-bottom: 0.4rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(<%= columns %>, minmax(0, 1fr));
    column-gap: 2rem;
    border-top: 1px solid var(--ink);
  }

  /* An odd last story takes the full row rather than leaving an empty cell. */
  .grid .item:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .grid .item:last-child:nth-child(odd) .teaser { max-width: 40rem; }

  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "kicker arrow"
      "title  arrow"
      "teaser arrow";
    column-gap: 0.75rem;
    padding: 0.8rem 0 0.85rem;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .item .kicker {
    grid-area: kicker;
    margin: 0 0 0.25rem;
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .item h3 {
    grid-area: title;
    margin: 0;
    font-size: 1.04rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .item .teaser {
    grid-area: teaser;
    margin: 0.3rem 0 0;
    font-size: 0.86rem;
    line-height: 1.42;
    color: var(--muted);
  }

  .item .arrow {
    grid-area: arrow;
    align-self: center;
    font-family: var(--sans);
    font-size: 1.1rem;
    color: var(--accent);
    transition: transform 160ms ease;
  }

  @media (hover: hover) {
    .item:hover h3 {
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 0.15em;
    }
    .item:hover .arrow, .hero:hover .cta .arrow { transform: translateX(3px); }
    .hero:hover .cta { filter: brightness(1.12); }
  }

  [dir="rtl"] .item:hover .arrow,
  [dir="rtl"] .hero:hover .cta .arrow { transform: translateX(-3px); }

  /* ---- why these sections ------------------------------------------------ */

  .impact {
    margin: 1.1rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--rule);
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .impact .label { display: block; margin-bottom: 0.45rem; }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 2rem;
    font-family: var(--sans);
    font-size: 0.74rem;
    line-height: 1.38;
    color: var(--muted);
  }

  .impact-row { display: flex; gap: 0.5rem; align-items: baseline; }

  .impact-name {
    flex: 0 0 5.5rem;
    font-weight: 700;
    color: var(--ink);
  }

  /* ---- note ------------------------------------------------------------- */

  .note {
    margin: 1rem 0 0;
    padding: 0.7rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--rule-soft);
    font-size: 0.86rem;
  }

  [dir="rtl"] .note { border-left: 0; border-right: 3px solid var(--accent); }

  .note h2 { margin: 0 0 0.2rem; font-size: 0.66rem; }
  .note p { margin: 0; }

  /* ---- footer ----------------------------------------------------------- */

  footer {
    margin-top: 1.1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--muted);
  }

  footer p { margin: 0 0 0.2rem; }
  footer .site { font-weight: 600; color: var(--ink); }

  .empty { padding: 2rem 0; color: var(--muted); }

  /* ---- small screens ----------------------------------------------------- */

  @media (max-width: 40rem) {
    .sheet { padding: 1.1rem 1.15rem 1.5rem; }
    .masthead { flex-direction: column; align-items: flex-start; }
    .prepared { text-align: start; max-width: none; }
    .hero { padding: 1.2rem 1.15rem 1.1rem; }
    .hero h2 { font-size: 1.65rem; }
    .grid, .impact-grid { grid-template-columns: 1fr; }
  }

  /* ---- print / PDF -------------------------------------------------------- */

  @page {
    size: <%= content.print.pageSize %>;
    margin: <%= content.print.margin %>;
  }

  @media print {
    body { background: var(--paper); font-size: 10.5pt; line-height: 1.42; }

    .sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      min-height: 0;
      border-top-width: 4px;
      padding-top: 0.75rem;
    }

    /*
     * Tighter than the screen: a sheet has a fixed height and the page is
     * measured against it, so every line saved here is type size kept.
     */
    .topbar { padding-bottom: 0.45rem; }
    .masthead { padding: 0.65rem 0 0.75rem; }
    .masthead h1 { font-size: 1.4rem; }
    .hero { padding: 1.15rem 1.3rem 1.05rem; margin-bottom: 0.85rem; }
    .hero .kicker { margin-bottom: 0.6rem; font-size: 0.76rem; }
    .hero h2 { font-size: 1.9rem; }
    .hero .standfirst { margin-top: 0.6rem; font-size: 1rem; line-height: 1.42; }
    .hero .foot { margin-top: 0.85rem; padding-top: 0.65rem; }
    .cta { padding: 0.4rem 0.85rem; }
    .more .label { padding-bottom: 0.3rem; }
    .item { padding: 0.55rem 0 0.6rem; }
    .item h3 { font-size: 0.98rem; line-height: 1.22; }
    .item .teaser { margin-top: 0.2rem; font-size: 0.8rem; line-height: 1.36; }
    .impact { margin-top: 0.8rem; padding-top: 0.55rem; }
    .impact-grid { font-size: 0.68rem; line-height: 1.32; gap: 0.25rem 1.5rem; }
    .impact-name { flex-basis: 4.75rem; }
    footer { margin-top: 0.8rem; padding-top: 0.45rem; font-size: 0.64rem; }

    /* The hero is ink on purpose; keep it that way on paper. */
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    .hero, .item, .impact { break-inside: avoid; page-break-inside: avoid; }
    .masthead, .topbar { break-after: avoid; page-break-after: avoid; }
    footer { break-before: avoid; page-break-before: avoid; }
  }
</style>
</head>
<body>
<div class="sheet">

<% for (const block of content.blocks) { %>
  <% if (block.type === "masthead") { %>
    <div class="topbar">
      <span class="brand"><%= brand.name %> <span>/ <%= brand.tagline %></span></span>
      <span class="when"><%= dateLong %></span>
    </div>
    <header class="masthead">
      <div>
        <% if (eyebrow) { %><p class="label eyebrow"><%= eyebrow %></p><% } %>
        <h1><%= content.title %></h1>
      </div>
      <% if (preparedFor) { %>
        <p class="prepared">
          <span class="label"><%= content.labels.preparedFor %></span>
          <strong><%= preparedFor %></strong>
        </p>
      <% } %>
    </header>
  <% } %>

  <% if (block.type === "summary") { %>
    <dl class="summary">
      <div>
        <dt class="label"><%= content.labels.storiesToday %></dt>
        <dd><%= count %></dd>
      </div>
      <% if (topics) { %>
        <div>
          <dt class="label"><%= content.labels.topics %></dt>
          <dd><%= topics %></dd>
        </div>
      <% } %>
    </dl>
  <% } %>

  <% if (block.type === "stories") { %>
    <% if (!stories.length) { %>
      <p class="empty">No coverage matched your topics on this date.</p>
    <% } %>

    <% if (hero) { %>
      <% const Tag = hero.url ? "a" : "div"; %>
      <<%- Tag %> class="hero"<% if (hero.url) { %> href="<%= hero.url %>"<% } %>>
        <article>
          <p class="kicker">
            <% if (hero.kicker) { %><span class="section"><%= hero.kicker %></span><% } %>
            <% if (hero.why) { %><span class="why"><%= hero.why %></span><% } %>
          </p>
          <h2><%= hero.headline %></h2>
          <% if (hero.standfirst) { %><p class="standfirst"><%= hero.standfirst %></p><% } %>
          <div class="foot">
            <span><% if (hero.source) { %><%= content.labels.reportedBy %> <%= hero.source %><% } %></span>
            <% if (hero.url) { %>
              <span class="cta"><%= content.labels.readStory %> <span class="arrow">→</span></span>
            <% } %>
          </div>
        </article>
      </<%- Tag %>>
    <% } %>

    <% if (items.length) { %>
      <section class="more">
        <% if (hero && content.labels.alsoToday) { %>
          <span class="label"><%= content.labels.alsoToday %></span>
        <% } %>
        <div class="grid">
          <% for (const story of items) { %>
            <% const Tag = story.url ? "a" : "div"; %>
            <<%- Tag %> class="item"<% if (story.url) { %> href="<%= story.url %>"<% } %>>
              <article style="display: contents">
                <% if (story.kicker) { %><p class="kicker"><%= story.kicker %></p><% } %>
                <h3><%= story.headline %></h3>
                <% if (story.teaser) { %><p class="teaser"><%= story.teaser %></p><% } %>
                <span class="arrow" aria-hidden="true">→</span>
              </article>
            </<%- Tag %>>
          <% } %>
        </div>
      </section>
    <% } %>
  <% } %>

  <% if (block.type === "impact" && reader && sections.length) { %>
    <section class="impact">
      <span class="label"><%= content.labels.whyThese %></span>
      <div class="impact-grid">
        <% for (const section of sections) { %>
          <div class="impact-row">
            <span class="impact-name"><%= section.name %></span>
            <span class="impact-why"><%= section.why %></span>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (block.type === "note" && block.body) { %>
    <aside class="note">
      <% if (block.title) { %><h2 class="label"><%= block.title %></h2><% } %>
      <p><%= block.body %></p>
    </aside>
  <% } %>

  <% if (block.type === "footer") { %>
    <footer>
      <% if (content.footnote) { %><p><%= content.footnote %></p><% } %>
      <p><span class="site"><%= brand.name %></span> · <%= brand.tagline %> · <%= pageUrl %> · <%= generatedAt %></p>
    </footer>
  <% } %>
<% } %>

</div>
</body>
</html>
