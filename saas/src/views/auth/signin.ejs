<%- include("../partials/header") %>

<section class="card signin">
  <h1><%= heading %></h1>

  <p class="lead">
    Rnews1 has no passwords. Enter your work email and we send you a link that
    signs you in — the same link whether you have used Rnews1 before or not.
  </p>

  <form id="login-form">
    <label for="email">Work email</label>

    <div class="field-row">
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@company.com"
        required
        autofocus
      >
      <button>Email me a link →</button>
    </div>
  </form>

  <p id="message" role="status"></p>

  <ul class="small">
    <li>The link works once and expires after 20 minutes.</li>
    <li>No card is needed to sign in or to preview your coverage.</li>
    <li>
      New here? Following the link creates your account — there is nothing
      separate to register.
    </li>
  </ul>
</section>

<section class="card">
  <h2>What happens after you sign in</h2>

  <ol>
    <li>Choose one industry and two keywords to follow.</li>
    <li>Preview the coverage before you pay anything.</li>
    <li>Activate for $25/month, then upload the audience you send to.</li>
    <li>Add 10 stakeholders from your company and your feed goes live.</li>
  </ol>

  <p class="small">
    Staff looking for the ad server want <a href="/admin/login">staff sign in</a>.
  </p>
</section>

<script src="/app.js" defer></script>

<%- include("../partials/footer") %>
